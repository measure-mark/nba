# Copy to .env and edit. docker-compose reads .env automatically.
#   cp .env.example .env

# Which leagues to sweep (comma separated, must exist in leagues/leagues.yaml).
LEAGUES=nba,wnba

# THE JOB: which seasons should exist locally. Ranges allowed.
#   SEASONS=2025            one season
#   SEASONS=2015-2025       a decade
#   SEASONS=1997-2010,2025  mix
# Unset means "the current season" only.
#
# The scraper works this target down continuously and only idles once it is complete;
# there is no separate backfill mode. At 19 requests/65s a decade of NBA is days of
# work, so expect it to run for a long time. It is resumable -- the cache is on disk.
#
# Note the label convention differs by league: NBA 2025 means the 2024-25 season, WNBA
# 2025 is the 2025 calendar season.
SEASONS=

# Once caught up, how long to wait before checking for new games.
IDLE_POLL_SECONDS=21600

# How stale the in-progress season's schedule pages may get before re-fetching. Finished
# seasons are never re-fetched -- their schedules cannot change.
SCHEDULE_MAX_AGE_SECONDS=21600

LOG_LEVEL=INFO
